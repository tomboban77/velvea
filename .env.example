# ------------------------------------------------------------
# Velvea — environment variables
# Copy to .env and fill in. Never commit .env.
#
# The server refuses to boot in production if AUTH_SECRET is missing or weak,
# if Stripe is configured without a webhook secret, or if NEXT_PUBLIC_SITE_URL
# is unset. See src/lib/env.ts.
# ------------------------------------------------------------

# Database (Neon / Supabase / local Postgres). Include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@host/velvea?sslmode=require"
# Direct (non-pooled) connection, used by migrations.
DIRECT_URL=""

# Auth — REQUIRED. Minimum 32 characters; placeholders are rejected.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public site URL (used for links in emails, Stripe redirects, canonical URLs)
# Local dev below. In Vercel (Production) set this to https://www.velvea.ca — it drives
# canonical URLs, Open Graph, robots.txt, sitemap.xml, Stripe redirects and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Search-engine indexing switch. Unset or "off" = every storefront page is
# noindex and the sitemap is empty (safe default for previews and pre-launch).
# "home" = only the homepage may be indexed. "all" = launch. Flip it in Vercel
# (Production) and redeploy; removal from Google's index is not instant.
SITE_INDEXING=off

# Search Console / Bing Webmaster ownership tokens (meta-tag method). Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Unset = GA is not loaded.
# Loads with consent denied; the storefront consent banner grants analytics
# cookies only after the visitor accepts. Ad signals stay denied.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe (test keys start with sk_test_ / pk_test_)
# STRIPE_WEBHOOK_SECRET is mandatory whenever STRIPE_SECRET_KEY is set:
# unsigned webhooks are rejected with 503.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Record orders without taking payment. Only for demos with no Stripe keys —
# the customer is emailed "payment to follow", never "order confirmed".
# Must stay unset (or "false") whenever STRIPE_SECRET_KEY is present.
ALLOW_OFFLINE_ORDERS=""

# Cloudinary (Dashboard → Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Resend (transactional email). Emails log to console until set.
RESEND_API_KEY=""
EMAIL_FROM="Velvea <hello@velvea.ca>"
EMAIL_REPLY_TO="hello@velvea.ca"
ORDER_NOTIFY_EMAIL="orders@velvea.ca"

# Rate limiting. Without these the limiter falls back to per-instance memory,
# which resets on every cold start — set them before launch.
# Upstash → Redis database → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile on the public forms (newsletter, reviews, corporate).
# Leave the secret empty to disable the check entirely.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Seeding — required by `npm run db:seed`, which has no fallback credentials.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Also seed the twelve sample baskets, their reviews and the placeholder gift
# guides. Leave unset for a real store: the seed then creates only structure
# (collections, custom builder, settings, admin user).
SEED_DEMO_CONTENT=""
