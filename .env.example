# ------------------------------------------------------------
# Velvea — environment variables
# Copy to .env and fill in. Never commit .env.
# ------------------------------------------------------------

# Database (Neon / Supabase / local Postgres). Include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@host/velvea?sslmode=require"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for links in emails, Stripe redirects, canonical URLs)
# Local dev. In Vercel (Production) set this to https://www.velvea.ca — it drives canonical
# URLs, Open Graph, robots.txt, sitemap.xml, Stripe redirects and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (test keys start with sk_test_ / pk_test_)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cloudinary (Dashboard → Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Resend (transactional email). Emails log to console until set.
RESEND_API_KEY=""
EMAIL_FROM="Velvea <hello@velvea.ca>"
ORDER_NOTIFY_EMAIL="orders@velvea.ca"
